---
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import SearchButton from '../components/SearchButton.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCollection } from 'astro:content';
import { execSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';

const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');
const base = import.meta.env.BASE_URL;

const courses = allCourses.sort((a, b) => {
  const statusOrder = (s: string) => s === 'available' ? 0 : 1;
  return statusOrder(a.data.status) - statusOrder(b.data.status) || a.data.order - b.data.order;
});

// Count lessons per course (slug starts with courseSlug/)
function lessonCount(courseSlug: string) {
  return allLessons.filter(l => l.slug.startsWith(courseSlug + '/')).length;
}

// Git-derived created/modified dates per course, from the history of its
// frontmatter file plus everything under its lessons directory. Falls back
// to nulls (sorted last) if git isn't available in the build environment.
function getGitDates(paths: string[]) {
  const existing = paths.filter(p => fs.existsSync(path.join(process.cwd(), p)));
  if (existing.length === 0) return { created: null as string | null, modified: null as string | null };
  try {
    const args = existing.map(p => JSON.stringify(p)).join(' ');
    const out = execSync(`git log --format=%aI -- ${args}`, {
      cwd: process.cwd(),
      encoding: 'utf-8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
    if (!out) return { created: null, modified: null };
    const dates = out.split('\n').filter(Boolean);
    return { created: dates[dates.length - 1], modified: dates[0] };
  } catch {
    return { created: null, modified: null };
  }
}

function timeAgo(isoDate: string | null): string {
  if (!isoDate) return 'Unknown';
  const diffSec = Math.floor((Date.now() - new Date(isoDate).getTime()) / 1000);
  const units: [string, number][] = [
    ['year', 31536000], ['month', 2592000], ['week', 604800],
    ['day', 86400], ['hour', 3600], ['minute', 60],
  ];
  for (const [name, secs] of units) {
    const val = Math.floor(diffSec / secs);
    if (val >= 1) return `${val} ${name}${val > 1 ? 's' : ''} ago`;
  }
  return 'Just now';
}

const courseMeta = courses.map(course => {
  const { created, modified } = getGitDates([
    `src/content/courses/${course.slug}.md`,
    `src/content/lessons/${course.slug}`,
  ]);
  return { course, created, modified };
});

const byModified = [...courseMeta].sort((a, b) => {
  const ta = a.modified ? new Date(a.modified).getTime() : 0;
  const tb = b.modified ? new Date(b.modified).getTime() : 0;
  return tb - ta;
});

const byCreated = [...courseMeta].sort((a, b) => {
  const ta = a.created ? new Date(a.created).getTime() : 0;
  const tb = b.created ? new Date(b.created).getTime() : 0;
  return tb - ta;
});

const availableCount = courses.filter(c => c.data.status === 'available').length;
const totalCount = courses.length;
const hasComingSoon = availableCount < totalCount;

// Hero shortcuts go straight to a flagship course rather than a category anchor.
const HERO_COURSES = [
  { slug: 'physical-ai', label: '🤖 Physical AI' },
  { slug: 'ai-first-responders', label: '🚨 AI for First Responders' },
  { slug: 'secure-agentic-ai', label: '🛡️ Secure AI' },
  { slug: 'web-development', label: '💻 Web Dev' },
  { slug: 'ai-llm-skills', label: '🧠 LLMs' },
].filter(({ slug }) => courses.some(c => c.slug === slug && c.data.status === 'available'));

// Display order for categories; anything not listed here falls back to
// alphabetical order after these, so a new category never disappears silently.
const CATEGORY_ORDER = [
  'AI & Machine Learning',
  'AI for Public Safety',
  'Vibe Coding & No-Code AI',
  'Software Development',
  'IT & Cloud Infrastructure',
  'Business & Strategy',
  'Teaching & Instructional Design',
  'Skilled Trades',
];

function categorySlug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

const categories = [...new Set(courses.map(c => c.data.category))].sort((a, b) => {
  const ia = CATEGORY_ORDER.indexOf(a);
  const ib = CATEGORY_ORDER.indexOf(b);
  if (ia === -1 && ib === -1) return a.localeCompare(b);
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});

const coursesByCategory = categories.map(category => ({
  name: category,
  slug: categorySlug(category),
  courses: courses.filter(c => c.data.category === category),
}));
---

<BaseLayout title="Course Catalog" description="Master AI, web development, data science, and more — all built for complete beginners.">
  <div class="min-h-screen bg-gray-50 dark:bg-gray-950">

    <!-- ── Nav ──────────────────────────────────────── -->
    <nav class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-4 sm:px-6 h-16 flex items-center justify-between sticky top-0 z-20 gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">C</div>
        <span class="font-bold text-gray-900 dark:text-gray-100 truncate">Clark's Courses</span>
      </div>
      <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
        <SearchButton showLabel />
        <ThemeToggle />
        <div class="hidden sm:block text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
          {hasComingSoon ? `${availableCount} of ${totalCount} courses available` : `${totalCount} free courses`}
        </div>
      </div>
    </nav>

    <!-- ── Hero ─────────────────────────────────────── -->
    <section class="bg-gradient-to-br from-brand-700 via-brand-600 to-brand-500 text-white px-4 sm:px-6 py-14 sm:py-20">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-brand-200 text-sm font-semibold uppercase tracking-widest mb-4">
          Zero Fluff · Self-Paced · 100% Free &amp; Open-Access
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-5 leading-tight">
          Skills That Move the World Forward
        </h1>
        <p class="text-brand-100 text-base sm:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
          Practical short courses on AI, modern technology, and applied systems —
          built for complete beginners, taught through real-world projects.
        </p>
        <nav aria-label="Popular courses" class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-6">
          {HERO_COURSES.map(({ slug, label }) => (
            <a href={`${base}${slug}/`} class="hero-pill">{label}</a>
          ))}
        </nav>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a href="#all-courses" class="hero-cta-primary">
            Browse All {totalCount} Courses ↓
          </a>
          <a
            href={`${base}zero-to-vibe/`}
            class="hero-cta-ghost"
            aria-label="New to tech? Start with the Zero to Vibe beginner course"
          >
            New to Tech? Start Here →
          </a>
        </div>
      </div>
    </section>

    <!-- ── Continue learning (filled client-side from saved progress) ── -->
    <section
      id="continue-learning"
      aria-labelledby="continue-learning-heading"
      class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-12"
      data-index-url={`${base}course-index.json`}
      hidden
    >
      <h2 id="continue-learning-heading" class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">Continue learning</h2>
      <div data-continue-list class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    </section>

    <!-- ── Category jump nav ────────────────────────────── -->
    <div id="category-jump-nav" class="sticky top-16 z-10 bg-white/95 dark:bg-gray-900/95 backdrop-blur border-b border-gray-200 dark:border-gray-800 overflow-x-auto">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-2 whitespace-nowrap">
        <button
          type="button"
          id="ai-filter-toggle"
          data-ai-filter-toggle
          aria-pressed="false"
          title="Filter the catalog to AI-related courses only — the URL updates so you can share the filtered link"
          class="text-xs font-semibold text-brand-700 dark:text-brand-300 bg-brand-50 dark:bg-brand-950/50 hover:bg-brand-100 dark:hover:bg-brand-900/50 border border-brand-200 dark:border-brand-800 rounded-full px-3 py-1.5 transition-colors flex-shrink-0"
        >
          🤖 AI Courses Only
        </button>
        <span class="w-px h-4 bg-gray-200 dark:bg-gray-700 flex-shrink-0"></span>
        {coursesByCategory.map(({ name, slug, courses: catCourses }) => (
          <a
            href={`#${slug}`}
            data-category-pill={name}
            class="text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-950/50 border border-gray-200 dark:border-gray-800 rounded-full px-3 py-1.5 transition-colors flex-shrink-0"
          >
            {name} <span class="text-gray-500 dark:text-gray-400">· {catCourses.length}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- ── Course Catalog ────────────────────────────── -->
    <section id="all-courses" class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 scroll-mt-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">All Courses</h2>
          <p class="text-gray-500 dark:text-gray-400 mt-1">{totalCount} courses across {categories.length} categories · built for complete beginners</p>
        </div>
        {hasComingSoon && <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-brand-500 inline-block"></span>
          <span class="text-sm text-gray-500 dark:text-gray-400">Available</span>
          <span class="w-3 h-3 rounded-full bg-gray-300 inline-block ml-3"></span>
          <span class="text-sm text-gray-500 dark:text-gray-400">Coming soon</span>
        </div>}
      </div>

      <!-- View switcher + text filter -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-10 sm:mb-14">
        <div id="view-switcher" class="flex items-center gap-1 bg-gray-100 dark:bg-gray-800 rounded-lg p-1 w-fit">
          <button type="button" data-view-btn="category" class="view-switcher-btn" aria-pressed="true">
            By Category
          </button>
          <button type="button" data-view-btn="modified" class="view-switcher-btn" aria-pressed="false">
            Recently Modified
          </button>
          <button type="button" data-view-btn="created" class="view-switcher-btn" aria-pressed="false">
            Recently Created
          </button>
        </div>
        <div class="relative sm:ml-auto sm:w-72">
          <label for="course-filter" class="sr-only">Filter courses</label>
          <Icon name="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400 pointer-events-none" />
          <input
            id="course-filter"
            type="search"
            placeholder="Filter courses…"
            autocomplete="off"
            class="w-full pl-9 pr-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 placeholder:text-gray-500 dark:placeholder:text-gray-500
                   focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200 dark:focus:ring-brand-800"
          />
        </div>
      </div>
      <p id="filter-status" class="sr-only" aria-live="polite"></p>

      <!-- Panel: By Category -->
      <div data-view-panel="category" class="space-y-14 sm:space-y-16">
        {coursesByCategory.map(({ name, slug, courses: catCourses }) => (
          <div id={slug} data-category-section={name} class="scroll-mt-32">
            <div class="flex items-baseline gap-3 mb-6">
              <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">{name}</h3>
              <span class="text-sm text-gray-500 dark:text-gray-400">{catCourses.length} course{catCourses.length !== 1 ? 's' : ''}</span>
            </div>

            <div class="grid gap-3 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {catCourses.map(course => (
                <CourseCard
                  course={course}
                  count={lessonCount(course.slug)}
                  href={course.data.status === 'available' ? `${base}${course.slug}/` : undefined}
                  headingLevel={4}
                />
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Panel: Recently Modified -->
      <div data-view-panel="modified" class="grid gap-3 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3" hidden>
        {byModified.map(({ course, modified }) => (
          <CourseCard
            course={course}
            count={lessonCount(course.slug)}
            href={course.data.status === 'available' ? `${base}${course.slug}/` : undefined}
            dateBadge={`Updated ${timeAgo(modified)}`}
          />
        ))}
      </div>

      <!-- Panel: Recently Created -->
      <div data-view-panel="created" class="grid gap-3 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3" hidden>
        {byCreated.map(({ course, created }) => (
          <CourseCard
            course={course}
            count={lessonCount(course.slug)}
            href={course.data.status === 'available' ? `${base}${course.slug}/` : undefined}
            dateBadge={`Added ${timeAgo(created)}`}
          />
        ))}
      </div>

      <div id="filter-empty" class="text-center py-16 text-gray-500 dark:text-gray-400" hidden>
        <p class="font-semibold text-gray-700 dark:text-gray-300">No courses match your filters.</p>
        <button type="button" data-clear-filters class="mt-3 text-sm font-semibold text-brand-700 dark:text-brand-300 hover:underline">
          Clear filters
        </button>
      </div>
    </section>

    <script>
      // Bundled scripts run once under the client router, so (re)bind on every
      // page load; the early return skips pages that aren't the catalog.
      document.addEventListener('astro:page-load', () => {
        if (!document.getElementById('view-switcher')) return;

        const buttons = document.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
        const panels = document.querySelectorAll<HTMLElement>('[data-view-panel]');
        const jumpNav = document.getElementById('category-jump-nav');

        function setView(view: string) {
          panels.forEach(p => {
            p.hidden = p.getAttribute('data-view-panel') !== view;
          });
          buttons.forEach(b => {
            const active = b.getAttribute('data-view-btn') === view;
            b.setAttribute('aria-pressed', String(active));
          });
          if (jumpNav) jumpNav.hidden = view !== 'category';
        }

        buttons.forEach(btn => {
          btn.addEventListener('click', () => setView(btn.getAttribute('data-view-btn')!));
        });

        // Smooth-scroll in-page anchors (hero pills, jump nav, "Browse" CTA)
        // via JS rather than a global `scroll-behavior: smooth`, since Chrome
        // can fail to honor an initial page-load's URL fragment when that CSS
        // property is set on <html>.
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
          link.addEventListener('click', (e) => {
            const id = link.getAttribute('href')!.slice(1);
            const target = document.getElementById(id);
            if (!target) return;
            e.preventDefault();
            target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
            history.pushState(null, '', `#${id}`);
          });
        });

        // ── Catalog filters ───────────────────────────────────
        // "AI Courses Only" (?filter=ai) and the text box (?q=...) combine. Both
        // are mirrored in the URL so a filtered view can be shared or bookmarked,
        // and re-applied on load. Category sections and jump-nav pills with no
        // matching courses are hidden too.
        const AI_CATEGORY = /\bai\b/i;
        const aiToggle = document.querySelector<HTMLButtonElement>('[data-ai-filter-toggle]');
        const filterInput = document.getElementById('course-filter') as HTMLInputElement | null;
        const filterStatus = document.getElementById('filter-status');
        const filterEmpty = document.getElementById('filter-empty');
        const categorySections = document.querySelectorAll<HTMLElement>('[data-category-section]');
        const categoryPills = document.querySelectorAll<HTMLAnchorElement>('[data-category-pill]');
        const courseCards = document.querySelectorAll<HTMLElement>('.module-card[data-category]');

        const params = new URLSearchParams(location.search);
        let aiOnly = params.get('filter') === 'ai';
        if (filterInput) filterInput.value = params.get('q') ?? '';

        function applyFilters({ updateUrl = true } = {}) {
          const query = filterInput?.value.trim().toLowerCase() ?? '';
          const terms = query.split(/\s+/).filter(Boolean);

          courseCards.forEach(card => {
            const matchesAI = !aiOnly || AI_CATEGORY.test(card.dataset.category ?? '');
            const text = card.dataset.searchText ?? '';
            const matchesText = terms.every(t => text.includes(t));
            card.style.display = matchesAI && matchesText ? '' : 'none';
          });

          const visibleCategories = new Set<string>();
          categorySections.forEach(section => {
            const anyVisible = [...section.querySelectorAll<HTMLElement>('.module-card')].some(c => c.style.display !== 'none');
            section.style.display = anyVisible ? '' : 'none';
            if (anyVisible) visibleCategories.add(section.dataset.categorySection!);
          });
          categoryPills.forEach(pill => {
            pill.style.display = visibleCategories.has(pill.dataset.categoryPill!) ? '' : 'none';
          });

          // Count within the panel currently on screen (each course appears once per panel).
          const activePanel = [...panels].find(p => !p.hidden);
          const shown = activePanel
            ? [...activePanel.querySelectorAll<HTMLElement>('.module-card')].filter(c => c.style.display !== 'none').length
            : 0;
          const filtering = aiOnly || terms.length > 0;
          if (filterEmpty) filterEmpty.hidden = !filtering || shown > 0;
          if (filterStatus) filterStatus.textContent = filtering ? `${shown} course${shown === 1 ? '' : 's'} shown` : '';

          if (aiToggle) {
            aiToggle.setAttribute('aria-pressed', String(aiOnly));
            aiToggle.textContent = aiOnly ? '✕ Clear AI Filter' : '🤖 AI Courses Only';
          }
          if (updateUrl) {
            const url = new URL(location.href);
            if (aiOnly) url.searchParams.set('filter', 'ai');
            else url.searchParams.delete('filter');
            if (query) url.searchParams.set('q', query);
            else url.searchParams.delete('q');
            history.replaceState(history.state, '', url);
          }
        }

        aiToggle?.addEventListener('click', () => {
          aiOnly = !aiOnly;
          applyFilters();
        });
        filterInput?.addEventListener('input', () => applyFilters());
        document.querySelector('[data-clear-filters]')?.addEventListener('click', () => {
          aiOnly = false;
          if (filterInput) { filterInput.value = ''; filterInput.focus(); }
          applyFilters();
        });
        buttons.forEach(btn => btn.addEventListener('click', () => applyFilters({ updateUrl: false })));

        applyFilters({ updateUrl: false });
      });
    </script>

    <script>
      import { getLastVisited, getProgress, resumeLesson } from '../scripts/progress';

      type IndexCourse = {
        slug: string; title: string; icon: string; color: string; href: string;
        lessons: { slug: string; title: string; href: string }[];
      };

      // Shows up to three in-progress courses, most recently visited first.
      async function renderContinueLearning() {
        const section = document.getElementById('continue-learning');
        const list = section?.querySelector('[data-continue-list]');
        if (!section || !list) return;

        const progress = getProgress();
        if (Object.keys(progress).length === 0) return;

        let index: IndexCourse[];
        try {
          index = await (await fetch(section.dataset.indexUrl!)).json();
        } catch { return; }

        const lastVisited = getLastVisited();
        const inProgress = index
          .map(course => {
            const slugs = course.lessons.map(l => l.slug);
            const done = slugs.filter(s => progress[s] === 'complete').length;
            const started = slugs.some(s => progress[s]);
            const resume = course.lessons.find(l => l.slug === resumeLesson(course.slug, slugs));
            return { course, done, started, resume, at: lastVisited[course.slug]?.at ?? 0 };
          })
          .filter(c => c.started && c.resume)
          .sort((a, b) => b.at - a.at)
          .slice(0, 3);

        if (inProgress.length === 0) return;

        list.replaceChildren(...inProgress.map(({ course, done, resume }) => {
          const total = course.lessons.length;
          const pct = Math.round((done / total) * 100);
          const card = document.createElement('a');
          card.href = resume!.href;
          card.className = 'module-card flex items-center gap-4 p-4 min-w-0';
          card.innerHTML = `
            <span class="text-3xl flex-shrink-0" aria-hidden="true"></span>
            <span class="flex-1 min-w-0">
              <span class="block font-bold text-gray-900 dark:text-gray-100 truncate"></span>
              <span class="block text-sm text-gray-500 dark:text-gray-400 truncate"></span>
              <span class="mt-2 flex items-center gap-2">
                <span class="flex-1 h-1.5 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
                  <span class="block h-full rounded-full" style="width: ${pct}%"></span>
                </span>
                <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">${done}/${total}</span>
              </span>
            </span>
            <span class="text-gray-400 dark:text-gray-500 flex-shrink-0" aria-hidden="true">→</span>`;
          card.firstElementChild!.textContent = course.icon;
          const texts = card.querySelectorAll('.truncate');
          texts[0].textContent = course.title;
          texts[1].textContent = `Next: ${resume!.title}`;
          (card.querySelector('.rounded-full > .rounded-full') as HTMLElement).style.backgroundColor = course.color;
          return card;
        }));
        section.hidden = false;
      }

      // Bundled scripts run once under the client router, so re-render on every
      // page load (the function no-ops on pages without the section).
      document.addEventListener('astro:page-load', renderContinueLearning);
    </script>

    <!-- ── Footer ────────────────────────────────────── -->
    <Footer />
  </div>
</BaseLayout>
