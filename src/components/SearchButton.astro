---
import Icon from './Icon.astro';

export interface Props {
  /** Show the "Search" text label next to the icon on wider screens. */
  showLabel?: boolean;
  class?: string;
}

const { showLabel = false, class: className = '' } = Astro.props;
---
<button
  type="button"
  data-search-open
  aria-label="Search courses and lessons"
  aria-keyshortcuts="Meta+K Control+K /"
  class={`flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 border border-gray-200 dark:border-gray-800 rounded-lg px-2.5 sm:px-3 py-1.5 transition-colors flex-shrink-0 ${className}`}
>
  <Icon name="search" />
  {showLabel && <span class="hidden sm:inline">Search</span>}
  <kbd class="hidden sm:inline text-xs bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-800 rounded px-1.5 py-0.5 font-sans">⌘K</kbd>
</button>
