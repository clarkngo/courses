---
// Safety "Quick Exit" for courses about abuse: one click (or Escape twice) swaps
// this tab to a neutral page with location.replace — so Back skips the course —
// and opens another neutral tab. It is a real link, so it still works without JS.
export interface Props {
  courseSlug: string;
}

/** Courses whose pages get the Quick Exit button. */
const QUICK_EXIT_COURSES = new Set(['reclaim-your-power']);
const NEUTRAL_URL = 'https://www.google.com/search?q=weather';

const show = QUICK_EXIT_COURSES.has(Astro.props.courseSlug);
---
{show && (
<a
  id="quick-exit"
  href={NEUTRAL_URL}
  data-neutral-url={NEUTRAL_URL}
  rel="noopener noreferrer"
  title="Leave this site right away (or press Esc twice)"
  class="fixed z-[60] inset-x-0 bottom-0 flex items-center justify-center gap-2 h-12 px-4
         bg-red-700 text-white font-bold text-sm shadow-lg
         hover:bg-red-800 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-red-400
         xl:inset-x-auto xl:right-5 xl:bottom-5 xl:h-auto xl:py-2.5 xl:rounded-full
         dark:bg-red-600 dark:hover:bg-red-700"
>
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 6 6 18M6 6l12 12" />
  </svg>
  Quick Exit
  <span class="font-normal opacity-80 xl:hidden">(or press Esc twice)</span>
</a>
)}

<style is:global>
  /* Below xl there's no side margin to tuck the button into, so it's a full-width
     bar and we reserve its strip instead of letting it sit on top of the text. */
  @media (max-width: 1279px) {
    body:has(#quick-exit) {
      padding-bottom: 3rem;
    }
    /* The lesson layout is a fixed-height scroll shell; shrink it above the bar. */
    body:has(#quick-exit) :has(> #lesson-main),
    body:has(#quick-exit) #course-sidebar {
      height: calc(100dvh - 3rem);
    }
  }
</style>

<script>
  // Delegated + bound once, so it survives client-side navigation.
  const ESC_WINDOW_MS = 600;
  let lastEscape = 0;

  function quickExit(url: string) {
    // Blank the page at once so nothing lingers on screen while the next page loads.
    document.documentElement.style.visibility = 'hidden';
    window.open(url, '_blank', 'noopener');
    window.location.replace(url);
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('#quick-exit');
    if (!link) return;
    e.preventDefault();
    quickExit(link.dataset.neutralUrl!);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const link = document.querySelector<HTMLAnchorElement>('#quick-exit');
    if (!link) return;
    const now = Date.now();
    if (now - lastEscape < ESC_WINDOW_MS) {
      quickExit(link.dataset.neutralUrl!);
    }
    lastEscape = now;
  });

  // If the browser restores this page from the back/forward cache, show it again.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) document.documentElement.style.visibility = '';
  });
</script>
