---
export interface Props {
  course: any;
  count: number;
  href?: string;
  dateBadge?: string | null;
  /** Heading level for the card title, so it nests under the surrounding section heading. */
  headingLevel?: 3 | 4;
}

const { course, count, href, dateBadge = null, headingLevel = 3 } = Astro.props;
const isAvailable = course.data.status === 'available';
const color = course.data.color || '#3b63f5';
const Heading = headingLevel === 4 ? 'h4' : 'h3';
// Text the catalog's "Filter courses" box matches against.
const searchText = [course.data.title, course.data.description, course.data.category, course.data.audience]
  .filter(Boolean).join(' ').toLowerCase();
const meta = [
  isAvailable && count > 0 ? `${count} lesson${count !== 1 ? 's' : ''}` : 'In development',
  dateBadge,
].filter(Boolean).join(' · ');
---

<!-- The whole card is clickable via a stretched link on the title (the title's
     ::after covers the card), so screen readers announce just the course name.
     Below `sm` it collapses to a compact row (icon tile + title + meta) so the
     36-course catalog stays scannable on phones. -->
<div
  data-category={course.data.category}
  data-search-text={searchText}
  class={`module-card relative overflow-hidden p-0 flex sm:flex-col group ${isAvailable ? '' : 'opacity-75'}`}
>
  <!-- Banner -->
  <div
    class="flex items-center justify-center w-16 flex-shrink-0 sm:w-auto sm:items-start sm:justify-between sm:px-5 sm:py-4"
    style={isAvailable ? `background-image: linear-gradient(135deg, ${color}, ${color}99);` : 'background-color: #e5e7eb;'}
  >
    <span class="text-3xl sm:text-4xl drop-shadow-sm" aria-hidden="true">{course.data.icon}</span>
    {!isAvailable && (
      <span class="hidden sm:inline text-xs font-medium px-2.5 py-1 rounded-full bg-white/80 text-gray-600 dark:text-gray-400">
        Coming soon
      </span>
    )}
  </div>

  <!-- Title, description, meta -->
  <div class="flex flex-col flex-1 min-w-0 px-4 py-3 sm:px-5 sm:pt-4 sm:pb-5">
    <Heading class="text-base sm:text-lg font-bold text-gray-900 dark:text-gray-100 leading-snug">
      {isAvailable ? (
        <a
          href={href}
          class="after:absolute after:inset-0 after:content-[''] group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors
                 focus-visible:outline-none after:rounded-2xl focus-visible:after:ring-2 focus-visible:after:ring-brand-500"
        >
          {course.data.title}
        </a>
      ) : course.data.title}
    </Heading>

    <p class="hidden sm:line-clamp-3 text-sm text-gray-600 dark:text-gray-400 leading-relaxed mt-2 mb-4 flex-1">
      {course.data.description}
    </p>

    <div class="flex items-center justify-between gap-3 text-xs text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">
      <span>{!isAvailable && <span class="sm:hidden">Coming soon · </span>}{meta}</span>
      {isAvailable && (
        <span class="hidden sm:inline font-semibold flex-shrink-0 text-gray-700 dark:text-gray-300 group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors" aria-hidden="true">
          View course →
        </span>
      )}
    </div>
  </div>
</div>
