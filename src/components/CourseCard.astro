---
export interface Props {
  course: any;
  count: number;
  href?: string;
  dateBadge?: string | null;
}

const { course, count, href, dateBadge = null } = Astro.props;
const isAvailable = course.data.status === 'available';
const color = course.data.color || '#3b63f5';
---

<div data-category={course.data.category} class={`module-card overflow-hidden p-0 flex flex-col group ${isAvailable ? 'cursor-pointer' : 'opacity-75'}`}>
  <!-- Banner -->
  <div
    class="relative flex items-start justify-between px-5 pt-4 pb-6"
    style={isAvailable ? `background-image: linear-gradient(135deg, ${color}, ${color}99);` : 'background-color: #e5e7eb;'}
  >
    <span class="text-4xl drop-shadow-sm">{course.data.icon}</span>
    {isAvailable ? (
      <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-white/90 text-gray-800">
        ✓ Available
      </span>
    ) : (
      <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-white/80 text-gray-500">
        Coming Soon
      </span>
    )}
  </div>

  <!-- Description + meta -->
  <div class="flex flex-col flex-1 px-6 pt-5">
    <p class="text-sm text-gray-500 leading-relaxed flex-1 mb-3">
      {course.data.description}
    </p>

    {dateBadge && (
      <p class="text-xs text-gray-400 mb-2">🕒 {dateBadge}</p>
    )}

    <p class="text-xs text-gray-400 mb-5">
      {isAvailable && count > 0 ? `${count} lesson${count !== 1 ? 's' : ''}` : '🔒 In development'}
    </p>
  </div>

  <!-- Title bar / CTA -->
  {isAvailable ? (
    <a
      href={href}
      class="flex items-center justify-between gap-2 px-6 py-4 font-bold text-white transition-opacity hover:opacity-90"
      style={`background-color: ${color}`}
    >
      <span class="truncate">{course.data.title}</span>
      <span class="flex-shrink-0">→</span>
    </a>
  ) : (
    <div class="flex items-center justify-between gap-2 px-6 py-4 font-semibold text-gray-500 bg-gray-100">
      <span class="truncate">{course.data.title}</span>
      <span class="flex-shrink-0 text-xs font-medium">Notify me</span>
    </div>
  )}
</div>
