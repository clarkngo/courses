---
import Icon from './Icon.astro';
---
<!-- Flips between light and dark and remembers the choice. Shows the icon for
     the theme you'd switch *to*; the label is kept in sync by the script. -->
<button
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  class="p-2 text-gray-500 hover:text-gray-700 border border-gray-200 rounded-lg transition-colors flex-shrink-0
         dark:text-gray-400 dark:hover:text-gray-200 dark:border-gray-700"
>
  <span class="dark:hidden"><Icon name="moon" /></span>
  <span class="hidden dark:inline"><Icon name="sun" /></span>
</button>

<script>
  function syncLabels() {
    const dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
      btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    });
  }

  // Delegated so it survives client-side navigation without rebinding.
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-theme-toggle]')) return;
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    syncLabels();
  });
  document.addEventListener('astro:page-load', syncLabels);
</script>
