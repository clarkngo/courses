---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL;
---
<div
  id="search-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Search courses and lessons"
  data-base={base}
  transition:persist
>
  <div id="search-panel">
    <div id="search-input-row">
      <span id="search-icon"><Icon name="search" class="w-5 h-5" /></span>
      <input
        id="search-input"
        type="text"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="search-results"
        aria-expanded="false"
        placeholder="Search courses and lessons..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd id="search-esc">esc</kbd>
    </div>
    <div id="search-results" role="listbox" aria-label="Search results"></div>
    <p id="search-hint" hidden></p>
    <div id="search-status" class="sr-only" aria-live="polite"></div>
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';
  import { getLastVisited } from '../scripts/progress';

  type Item = {
    type: 'course' | 'lesson';
    title: string;
    subtitle: string;
    description: string;
    icon: string;
    url: string;
  };

  // Bundled scripts run once per full page load, and #search-overlay is
  // transition:persist'd, so these listeners are bound exactly once.
  const overlay = document.getElementById('search-overlay')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results')!;
  const hintEl = document.getElementById('search-hint')!;
  const statusEl = document.getElementById('search-status')!;
  const base = overlay.dataset.base!;
  const MAX_RESULTS = 10;

  let items: Item[] | null = null;
  let activeIndex = -1;
  let currentResults: Item[] = [];
  let returnFocusTo: HTMLElement | null = null;

  async function loadIndex() {
    if (items) return items;
    const res = await fetch(`${base}search.json`);
    items = (await res.json()) as Item[];
    return items;
  }

  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]!));
  }

  const escapeRegExp = (str: string) => str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  function highlight(text: string, terms: string[]) {
    if (terms.length === 0) return escapeHtml(text);
    const re = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
    return text.split(re).map((part, i) => i % 2 ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part)).join('');
  }

  // Every term must appear somewhere; rank by how strongly the title matches.
  function score(item: Item, phrase: string, terms: string[]) {
    const title = item.title.toLowerCase();
    const subtitle = item.subtitle.toLowerCase();
    const haystack = `${title} ${subtitle} ${item.description.toLowerCase()}`;
    if (!terms.every(t => haystack.includes(t))) return -1;
    if (title === phrase) return 0;
    if (title.startsWith(phrase)) return 1;
    if (title.includes(phrase)) return 2;
    if (terms.every(t => title.includes(t))) return 3;
    if (terms.every(t => title.includes(t) || subtitle.includes(t))) return 4;
    return 5;
  }

  function render(results: Item[], terms: string[], heading?: string) {
    currentResults = results;
    activeIndex = results.length > 0 ? 0 : -1;
    input.setAttribute('aria-expanded', String(results.length > 0));

    const header = heading ? `<p class="search-section" role="presentation">${escapeHtml(heading)}</p>` : '';
    resultsEl.innerHTML = header + results.map((item, i) => `
      <a href="${item.url}" id="search-option-${i}" role="option" class="search-result" data-index="${i}">
        <span class="search-result-icon" aria-hidden="true">${item.icon}</span>
        <span class="search-result-text">
          <span class="search-result-title">${highlight(item.title, terms)}</span>
          <span class="search-result-meta">
            <span class="search-result-type">${item.type === 'course' ? 'Course' : 'Lesson'}</span>
            · ${escapeHtml(item.subtitle)}
          </span>
        </span>
      </a>
    `).join('');
    updateActive();
  }

  function updateActive() {
    resultsEl.querySelectorAll<HTMLElement>('.search-result').forEach((el, i) => {
      const active = i === activeIndex;
      el.setAttribute('aria-selected', String(active));
      if (active) el.scrollIntoView({ block: 'nearest' });
    });
    if (activeIndex >= 0) input.setAttribute('aria-activedescendant', `search-option-${activeIndex}`);
    else input.removeAttribute('aria-activedescendant');
  }

  function showHint(text: string) {
    hintEl.textContent = text;
    hintEl.hidden = !text;
  }

  // Empty query: offer the lessons the learner most recently opened.
  async function renderRecent() {
    const all = await loadIndex();
    const byUrl = new Map(all.map(item => [item.url, item]));
    const recent = Object.values(getLastVisited())
      .sort((a, b) => b.at - a.at)
      .map(({ lesson }) => {
        const [course, ...rest] = lesson.split('/');
        return byUrl.get(`${base}${course}/lessons/${rest.join('/')}`);
      })
      .filter((item): item is Item => Boolean(item))
      .slice(0, 5);

    if (input.value.trim()) return; // the learner started typing meanwhile
    render(recent, [], recent.length ? 'Jump back in' : undefined);
    const courses = all.filter(i => i.type === 'course').length;
    showHint(recent.length ? '' : `Search ${courses} courses and ${all.length - courses} lessons.`);
    statusEl.textContent = '';
  }

  async function handleInput() {
    const phrase = input.value.trim().toLowerCase();
    if (!phrase) { renderRecent(); return; }

    const terms = [...new Set(phrase.split(/\s+/))];
    const all = await loadIndex();
    const matches = all
      .map(item => ({ item, s: score(item, phrase, terms) }))
      .filter(({ s }) => s !== -1)
      .sort((a, b) => a.s - b.s || (a.item.type === 'course' ? -1 : 0) - (b.item.type === 'course' ? -1 : 0));

    render(matches.slice(0, MAX_RESULTS).map(({ item }) => item), terms);
    if (matches.length === 0) {
      showHint('No results. Try fewer or different words.');
      statusEl.textContent = 'No results';
    } else {
      showHint(matches.length > MAX_RESULTS ? `Showing ${MAX_RESULTS} of ${matches.length} — add a word to narrow it down.` : '');
      statusEl.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'}`;
    }
  }

  function openSearch() {
    returnFocusTo = document.activeElement as HTMLElement | null;
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    input.value = '';
    renderRecent();
    setTimeout(() => input.focus(), 0);
  }

  function closeSearch() {
    if (!overlay.classList.contains('open')) return;
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    if (returnFocusTo?.isConnected) returnFocusTo.focus();
    returnFocusTo = null;
  }

  // Clicking a result navigates via the client router, which doesn't tear down
  // the page (search-overlay is transition:persist'd) — close it explicitly.
  document.addEventListener('astro:before-preparation', () => { returnFocusTo = null; closeSearch(); });

  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest('[data-search-open]');
    if (trigger) {
      e.preventDefault();
      openSearch();
    }
  });

  document.addEventListener('keydown', (e) => {
    const isOpen = overlay.classList.contains('open');
    const metaK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';

    if (metaK) {
      e.preventDefault();
      isOpen ? closeSearch() : openSearch();
      return;
    }

    if (!isOpen) {
      const tag = (document.activeElement as HTMLElement | null)?.tagName;
      if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') {
        e.preventDefault();
        openSearch();
      }
      return;
    }

    if (e.key === 'Escape') {
      closeSearch();
    } else if (e.key === 'Tab') {
      e.preventDefault(); // keep focus in the dialog; arrows move through results
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (activeIndex < currentResults.length - 1) { activeIndex++; updateActive(); }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (activeIndex > 0) { activeIndex--; updateActive(); }
    } else if (e.key === 'Enter') {
      const active = currentResults[activeIndex];
      if (active) { e.preventDefault(); navigate(active.url); }
    }
  });

  resultsEl.addEventListener('mousemove', (e) => {
    const option = (e.target as Element).closest<HTMLElement>('.search-result');
    const index = option ? Number(option.dataset.index) : -1;
    if (index >= 0 && index !== activeIndex) { activeIndex = index; updateActive(); }
  });

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeSearch();
  });

  input.addEventListener('input', handleInput);
</script>

<style is:global>
  #search-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(15, 17, 26, 0.5);
    backdrop-filter: blur(3px);
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1.25rem 1.25rem;
  }
  #search-overlay.open { display: flex; }

  #search-panel {
    width: 100%;
    max-width: 34rem;
    background: white;
    border-radius: 1rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }

  #search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e5e7eb;
    flex-shrink: 0;
  }
  #search-icon { font-size: 1rem; opacity: 0.6; }
  #search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    font-family: inherit;
    color: #1f2937;
    background: transparent;
  }
  #search-input::placeholder { color: #9ca3af; }
  #search-esc {
    font-size: 0.6875rem;
    font-family: inherit;
    color: #6b7280;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 0.125rem 0.375rem;
  }

  #search-results {
    overflow-y: auto;
    padding: 0.5rem;
  }

  .search-result {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.625rem;
    text-decoration: none;
    color: inherit;
  }
  .search-result[aria-selected="true"] {
    background: #f0f4ff;
  }
  .search-result-icon { font-size: 1.25rem; line-height: 1.5rem; flex-shrink: 0; }
  .search-result-text { display: flex; flex-direction: column; min-width: 0; }
  .search-result-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #111827;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-result-title mark {
    background: #dbe4ff;
    color: #1c38c4;
    border-radius: 0.2rem;
  }
  .search-result-meta {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.125rem;
  }
  .search-result-type {
    font-weight: 600;
    color: #4b5563;
  }

  .search-section {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
    padding: 0.5rem 0.75rem 0.25rem;
  }

  #search-hint {
    padding: 0.75rem 1.25rem 1rem;
    text-align: center;
    color: #6b7280;
    font-size: 0.875rem;
  }
</style>
