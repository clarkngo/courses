---
import RiftLab from './RiftLab.astro';
import Stat from './Stat.astro';
import Chart from './Chart.astro';
---
<RiftLab title="Match History Explorer" lab="desc" subtitle="Pick a dataset or paste your own numbers (comma or space separated). The histogram marks the mean, the median, and a ±1 standard deviation band.">
  <div class="rl-controls">
    <label class="rl-field">
      <span class="rl-field-label">Dataset</span>
      <select data-act="dataset">
        <option value="gpm">Gold per minute — last 20 games</option>
        <option value="kdaA">KDA — Player A (steady)</option>
        <option value="kdaB">KDA — Player B (coin-flip)</option>
      </select>
    </label>
  </div>
  <textarea data-act="values" aria-label="Values to analyze"></textarea>
  <div class="rl-row">
    <button type="button" class="rl-btn" data-act="stomp">Add a stomp game</button>
    <button type="button" class="rl-btn ghost" data-act="feed">Add a feeding game</button>
    <button type="button" class="rl-btn ghost" data-act="reset">Reset</button>
  </div>
  <div class="rl-stats">
    <Stat name="n" label="Games (n)" />
    <Stat name="mean" label="Mean" />
    <Stat name="median" label="Median" />
    <Stat name="mode" label="Mode" />
    <Stat name="sd" label="Std. deviation" />
    <Stat name="iqr" label="IQR (Q1–Q3)" />
    <Stat name="range" label="Min – Max" />
    <Stat name="cv" label="Coeff. of variation" />
  </div>
  <Chart name="hist" caption="Distribution" label="Histogram of the selected values with mean and median markers">
    <div class="rl-legend"><span><i class="c1"></i>Count per bin</span><span><i class="c2"></i>Mean</span><span><i class="c3"></i>Median</span><span><i class="muted"></i>±1 SD</span></div>
  </Chart>
  <Chart name="strip" caption="KDA spread: same average, different player" label="Strip plot comparing KDA of two players with mean and standard deviation">
    <div class="rl-legend"><span><i class="c1"></i>Player A</span><span><i class="c2"></i>Player B</span><span>Bars show mean ± 1 SD</span></div>
  </Chart>
</RiftLab>

<script>
  import { onLab, setText, chart, fmt, pct, mean, median, sd, quantile, modes } from '../../scripts/riftlab';

  const DATA: Record<string, { values: number[]; bin: number; modeBin: number; label: string; stomp: number; feed: number }> = {
    gpm: { values: [412, 455, 388, 501, 437, 466, 420, 398, 445, 520, 431, 455, 470, 405, 455, 489, 362, 441, 478, 430], bin: 25, modeBin: 1, label: 'Gold per minute', stomp: 780, feed: 240 },
    kdaA: { values: [3.2, 2.8, 3.5, 3.0, 2.6, 3.4, 3.1, 2.9, 3.3, 3.0, 2.7, 3.6, 3.1, 2.8, 3.1], bin: 0.5, modeBin: 0.1, label: 'KDA', stomp: 18, feed: 0.2 },
    kdaB: { values: [0.8, 6.5, 1.2, 5.0, 2.1, 7.3, 0.5, 4.2, 1.0, 3.8, 6.0, 0.9, 2.4, 1.5, 2.9], bin: 0.5, modeBin: 0.1, label: 'KDA', stomp: 18, feed: 0.2 },
  };

  onLab('desc', (root) => {
    const select = root.querySelector<HTMLSelectElement>('[data-act="dataset"]')!;
    const area = root.querySelector<HTMLTextAreaElement>('[data-act="values"]')!;
    const hist = root.querySelector<SVGSVGElement>('[data-chart="hist"]')!;
    const strip = root.querySelector<SVGSVGElement>('[data-chart="strip"]')!;

    const parse = () => area.value.split(/[\s,;]+/).filter((t) => t !== '').map(Number).filter(Number.isFinite);

    const render = () => {
      const d = DATA[select.value];
      const xs = parse();
      if (xs.length < 2) {
        setText(root, 'n', String(xs.length));
        return;
      }
      const m = mean(xs);
      const s = sd(xs);
      const md = median(xs);
      const mo = modes(xs, d.modeBin);
      const q1 = quantile(xs, 0.25);
      const q3 = quantile(xs, 0.75);
      const dec = d.bin < 1 ? 2 : 1;
      setText(root, 'n', String(xs.length));
      setText(root, 'mean', fmt(m, dec));
      setText(root, 'median', fmt(md, dec));
      setText(root, 'mode', mo.values.length ? `${mo.values.slice(0, 3).join(', ')} (×${mo.count})` : 'none');
      setText(root, 'sd', fmt(s, dec));
      setText(root, 'iqr', `${fmt(q1, dec)}–${fmt(q3, dec)}`);
      setText(root, 'range', `${fmt(Math.min(...xs), dec)} – ${fmt(Math.max(...xs), dec)}`);
      setText(root, 'cv', pct(s / m));

      const lo = Math.floor(Math.min(...xs) / d.bin) * d.bin;
      const hi = Math.ceil((Math.max(...xs) + 1e-9) / d.bin) * d.bin;
      const nb = Math.max(1, Math.round((hi - lo) / d.bin));
      const counts = new Array(nb).fill(0);
      xs.forEach((x) => counts[Math.min(nb - 1, Math.floor((x - lo) / d.bin))]++);
      const yMax = Math.max(...counts) + 1;
      chart(hist, {
        xMin: lo, xMax: hi, yMin: 0, yMax,
        xLabel: d.label, yLabel: 'Games',
        areas: [{ pts: [[m - s, 0], [m - s, yMax], [m + s, yMax], [m + s, 0]], cls: 'c1' }],
        bars: counts.map((c, i) => ({ x0: lo + i * d.bin, x1: lo + (i + 1) * d.bin, y: c, cls: 'c1' })),
        vlines: [{ x: m, cls: 'c2', label: 'mean' }, { x: md, cls: 'c3' }],
      });
    };

    const drawStrip = () => {
      const a = DATA.kdaA.values;
      const b = DATA.kdaB.values;
      const jitter = (i: number) => ((i * 37) % 11) / 11 - 0.5;
      const band = (xs: number[], y: number, cls: string) => {
        const m = mean(xs);
        const s = sd(xs);
        return [
          { x1: m - s, y1: y, x2: m + s, y2: y, cls },
          { x1: m, y1: y - 0.25, x2: m, y2: y + 0.25, cls },
        ];
      };
      chart(strip, {
        xMin: 0, xMax: 8, yMin: 0, yMax: 3, height: 200,
        xLabel: `KDA   (A: mean ${fmt(mean(a))}, SD ${fmt(sd(a))}   ·   B: mean ${fmt(mean(b))}, SD ${fmt(sd(b))})`,
        yFmt: () => '',
        points: [
          ...a.map((x, i) => ({ x, y: 2 + jitter(i) * 0.5, cls: 'c1', title: `A: ${x}` })),
          ...b.map((x, i) => ({ x, y: 1 + jitter(i) * 0.5, cls: 'c2', title: `B: ${x}` })),
        ],
        segments: [...band(a, 2.45, 'c1'), ...band(b, 1.45, 'c2')],
      });
    };

    const load = () => {
      area.value = DATA[select.value].values.join(', ');
      render();
    };
    select.addEventListener('change', load);
    area.addEventListener('input', render);
    root.querySelector('[data-act="stomp"]')!.addEventListener('click', () => {
      area.value = `${area.value.trim()}, ${DATA[select.value].stomp}`;
      render();
    });
    root.querySelector('[data-act="feed"]')!.addEventListener('click', () => {
      area.value = `${area.value.trim()}, ${DATA[select.value].feed}`;
      render();
    });
    root.querySelector('[data-act="reset"]')!.addEventListener('click', load);
    load();
    drawStrip();
  });
</script>
