---
import RiftLab from './RiftLab.astro';
import Stat from './Stat.astro';
import Chart from './Chart.astro';
---
<RiftLab title="Multiple Regression & Model Evaluation" lab="multireg" subtitle="Predict a team's gold difference at 20:00 from early-game features. The model is fit on 70% of 160 simulated matches (training set) and scored on the 30% it has never seen (test set). Add the junk feature and watch which metrics notice.">
  <div class="rl-row" data-act="features">
    <label class="rl-note"><input type="checkbox" value="g10" checked /> Gold diff @10</label>
    <label class="rl-note"><input type="checkbox" value="kd10" /> Kill diff @10</label>
    <label class="rl-note"><input type="checkbox" value="dragons" /> Dragon diff</label>
    <label class="rl-note"><input type="checkbox" value="skins" /> Skins owned (junk)</label>
    <button type="button" class="rl-btn ghost" data-act="reseed">New season of data</button>
  </div>
  <div class="rl-stats">
    <Stat name="r2tr" label="R² (train)" />
    <Stat name="adj" label="Adjusted R² (train)" />
    <Stat name="r2te" label="R² (test)" />
    <Stat name="rmse" label="RMSE (test, gold)" />
  </div>
  <div class="rl-scroll"><table class="rl-table" data-stat="coef"></table></div>
  <Chart name="pva" caption="Predicted vs. actual gold diff @20" label="Scatter of predicted versus actual values with a 45 degree reference line">
    <div class="rl-legend"><span><i class="c1"></i>Train</span><span><i class="c2"></i>Test</span><span><i class="muted"></i>Perfect prediction (y = x)</span></div>
  </Chart>
  <p class="rl-note"><strong>Why not regress win/loss directly?</strong> Below, OLS is fit to the 0/1 outcome (a "linear probability model"). Notice where the line goes.</p>
  <div class="rl-stats">
    <Stat name="lpmSlope" label="Win prob. per +1k gold" />
    <Stat name="lpmHigh" label="'P(win)' at +6k gold" />
    <Stat name="lpmLow" label="'P(win)' at −6k gold" />
  </div>
  <Chart name="lpm" caption="Linear probability model: win (1) / loss (0) vs. gold diff @10" label="Win loss outcomes against gold difference with a straight regression line that exceeds the 0 to 1 range">
    <div class="rl-legend"><span><i class="c1"></i>Matches (jittered)</span><span><i class="c2"></i>OLS line</span><span><i class="muted"></i>Valid probability range</span></div>
  </Chart>
</RiftLab>

<script>
  import { onLab, setText, chart, fmt, ols, predictLinear, rSquared, mean, simulateMatches, type Match } from '../../scripts/riftlab';

  const LABELS: Record<string, string> = { g10: 'Gold diff @10', kd10: 'Kill diff @10', dragons: 'Dragon diff', skins: 'Skins owned' };

  onLab('multireg', (root) => {
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-act="features"] input'));
    const pva = root.querySelector<SVGSVGElement>('[data-chart="pva"]')!;
    const lpm = root.querySelector<SVGSVGElement>('[data-chart="lpm"]')!;
    const coef = root.querySelector<HTMLTableElement>('[data-stat="coef"]')!;
    let seed = 21;

    const render = () => {
      const data = simulateMatches(seed, 160);
      const train = data.slice(0, 112);
      const test = data.slice(112);
      const feats = boxes.filter((b) => b.checked).map((b) => b.value as keyof Match);
      const X = (rows: Match[]) => rows.map((m) => feats.map((f) => m[f]));
      const y = (rows: Match[]) => rows.map((m) => m.g20);
      const beta = feats.length ? ols(X(train), y(train)) : [mean(y(train))];
      if (!beta) return;
      const pred = (rows: Match[]) => X(rows).map((x) => predictLinear(beta, x));
      const yTr = y(train);
      const yTe = y(test);
      const pTr = pred(train);
      const pTe = pred(test);
      const r2tr = rSquared(yTr, pTr);
      const n = train.length;
      const k = feats.length;
      setText(root, 'r2tr', fmt(r2tr, 4));
      setText(root, 'adj', fmt(1 - ((1 - r2tr) * (n - 1)) / (n - k - 1), 4));
      setText(root, 'r2te', fmt(rSquared(yTe, pTe), 4));
      setText(root, 'rmse', fmt(Math.sqrt(mean(yTe.map((v, i) => (v - pTe[i]) ** 2))), 0));
      coef.innerHTML = `<tr><th>Term</th><th>Coefficient</th><th>Meaning</th></tr><tr><td>Intercept</td><td>${fmt(beta[0], 1)}</td><td>Predicted gold diff @20 when every feature is 0</td></tr>`
        + feats.map((f, i) => `<tr><td>${LABELS[f]}</td><td>${fmt(beta[i + 1], 2)}</td><td>+1 unit → ${fmt(beta[i + 1], 0)} gold @20, holding the others fixed</td></tr>`).join('');

      const all = [...yTr, ...yTe, ...pTr, ...pTe];
      const lo = Math.min(...all);
      const hi = Math.max(...all);
      chart(pva, {
        xMin: lo, xMax: hi, yMin: lo, yMax: hi, height: 300,
        xLabel: 'Predicted gold diff @20', yLabel: 'Actual',
        segments: [{ x1: lo, y1: lo, x2: hi, y2: hi, cls: 'muted' }],
        points: [
          ...pTr.map((p, i) => ({ x: p, y: yTr[i], cls: 'c1', r: 3 })),
          ...pTe.map((p, i) => ({ x: p, y: yTe[i], cls: 'c2', r: 4 })),
        ],
      });

      // Linear probability model on the full season.
      const xs = data.map((m) => m.g10);
      const ws = data.map((m) => m.win);
      const b = ols(xs.map((x) => [x]), ws)!;
      setText(root, 'lpmSlope', `${fmt(b[1] * 1000 * 100, 1)} pts`);
      setText(root, 'lpmHigh', fmt(b[0] + b[1] * 6000, 2));
      setText(root, 'lpmLow', fmt(b[0] - b[1] * 6000, 2));
      chart(lpm, {
        xMin: -6000, xMax: 6000, yMin: -0.4, yMax: 1.4, height: 240,
        xLabel: 'Gold difference at 10:00', yLabel: 'Win = 1',
        areas: [{ pts: [[-6000, 0], [-6000, 1], [6000, 1], [6000, 0]], cls: 'c4' }],
        segments: [{ x1: -6000, y1: b[0] - 6000 * b[1], x2: 6000, y2: b[0] + 6000 * b[1], cls: 'c2' }],
        points: data.map((m, i) => ({ x: m.g10, y: m.win + (((i * 37) % 13) / 13 - 0.5) * 0.12, cls: 'c1', r: 3 })),
        hlines: [{ y: 0 }, { y: 1 }],
      });
    };

    boxes.forEach((b) => b.addEventListener('change', render));
    root.querySelector('[data-act="reseed"]')!.addEventListener('click', () => { seed++; render(); });
    render();
  });
</script>
